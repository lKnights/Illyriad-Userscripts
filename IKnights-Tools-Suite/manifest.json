{
    "suite": "Illyriad Tools Suite",
    "manifestVersion": 1,
    "core": {
        "version": "1.2.0",
        "file": "core/IKTools-Core.js"
    },
    "modules": [
        {
            "id": "quartermaster",
            "name": "Quartermaster",
            "version": "1.0.0",
            "file": "tools/Quartermaster.js",
            "enabled": true
        },
        {
            "id": "notes",
            "name": "Notes",
            "version": "1.2.0",
            "file": "features/Notes.js",
            "enabled": true
        },
        {
            "id": "customizer",
            "name": "Customizer",
            "version": "1.1.0",
            "file": "features/Customizer.js",
            "enabled": true
        },
        {
            "id": "catalogue-data",
            "name": "Catalogue Data",
            "version": "1.0.0",
            "file": "data/CatalogueData.js",
            "enabled": true
        },
        {
            "id": "catalogue",
            "name": "Catalogue",
            "version": "1.1.0",
            "file": "tools/Catalogue.js",
            "requires": [
                "catalogue-data"
            ],
            "enabled": true
        },
        {
            "id": "luper-dark-warm",
            "name": "LuperDark (Warm) Interface Theme",
            "version": "1.0.0",
            "file": "themes/LuperDark_Warm.js",
            "requires": [
                "customizer"
            ],
            "enabled": true
        },
        {
            "id": "ui-tweaks",
            "name": "UI Tweaks",
            "version": "1.0.0",
            "file": "features/UITweaks.js",
            "enabled": true
        }
    ]
}
